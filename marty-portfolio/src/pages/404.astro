---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found — Marty Smithson"
  description="That page is not on Marty Smithson’s portfolio."
  path="/404"
>
  <main id="main" class="miss">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>No page here.</h1>
      <p>The portfolio is a single page. Use the links below.</p>
      <div class="hero-cta">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/#contact">Contact</a>
      </div>
    </div>
  </main>
</Base>
